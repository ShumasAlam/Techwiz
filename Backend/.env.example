PORT=5000
# MongoDB Atlas Connection URI:
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster credentials:
# Example: MONGODB_URI=mongodb+srv://admin:mypassword123@cluster0.abcde.mongodb.net/marketlink?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.your_cluster.mongodb.net/marketlink?retryWrites=true&w=majority
JWT_SECRET=marketlink_secret_jwt_key_2024_secure
JWT_EXPIRE=7d
NODE_ENV=development
